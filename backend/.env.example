# Reference only: the backend loads .env from the repository root.
# Copy only the settings you need into the root .env and replace placeholders.

# Optional catalogue overrides. Defaults work without these settings.
# MOVIE_DATA_PATH=YOUR_MODEL_READY_CATALOGUE_PATH
# MOVIE_ADDED_PATH=YOUR_APPROVED_ADDITIONS_CSV_PATH
# SUGGESTIONS_LOG=YOUR_LOCAL_SUGGESTIONS_JSONL_PATH

# Optional TMDB v4 Read Access Token.
# TMDB_READ_ACCESS_TOKEN=YOUR_TMDB_V4_READ_ACCESS_TOKEN

# Optional suggestion email delivery.
# SUGGESTION_TO=YOUR_SUGGESTION_RECIPIENT_EMAIL
# SUGGESTION_DEFAULT_TO=YOUR_FALLBACK_RECIPIENT_EMAIL
# SMTP_HOST=YOUR_SMTP_HOST
# SMTP_PORT=YOUR_SMTP_PORT
# SMTP_USER=YOUR_SMTP_USERNAME
# SMTP_PASSWORD=YOUR_SMTP_PASSWORD
# SMTP_FROM=YOUR_SENDER_EMAIL

# Optional per-client request limits per hour (positive integers).
# RATE_LIMIT_RECOMMEND_PER_HOUR=YOUR_RECOMMEND_LIMIT
# RATE_LIMIT_TMDB_PER_HOUR=YOUR_TMDB_LIMIT
# RATE_LIMIT_SUGGESTIONS_PER_HOUR=YOUR_SUGGESTION_LIMIT
